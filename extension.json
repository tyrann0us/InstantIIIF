{
  "name": "InstantIIIF",
  "version": "1.0.0",
  "author": [
    "[https://github.com/tyrann0us Philipp Bammes]"
  ],
  "url": "https://github.com/tyrann0us/InstantIIIF",
  "descriptionmsg": "instantiiif-desc",
  "license-name": "MIT",
  "type": "other",
  "requires": {
    "MediaWiki": ">= 1.44"
  },
  "load_composer_autoloader": true,
  "AutoloadNamespaces": {
    "MediaWiki\\Extension\\InstantIIIF\\": "src/"
  },
  "config": {
    "InstantIIIFDefaultTimeout": {
      "value": 5,
      "description": "HTTP timeout in seconds for IIIF fetches"
    }
  },
  "manifest_version": 2,
  "MessagesDirs": {
    "InstantIIIF": [
      "i18n"
    ]
  },
  "ResourceFileModulePaths": {
    "localBasePath": "",
    "remoteExtPath": "InstantIIIF"
  },
  "ResourceModules": {
    "ext.instantIIIF.title": {
      "scripts": [
        "resources/iiif-title.js"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    },
    "ext.instantIIIF.mmvPatch": {
      "scripts": [
        "resources/mmv-patch.js"
      ],
      "targets": [
        "desktop",
        "mobile"
      ],
      "dependencies": [
        "mediawiki.Title",
        "ext.instantIIIF.title"
      ],
      "position": "top"
    },
    "ext.instantIIIF.mediaSearch": {
      "scripts": [
        "resources/media-search.js"
      ],
      "targets": [
        "desktop",
        "mobile"
      ],
      "dependencies": [
        "mediawiki.api",
        "ext.instantIIIF.title"
      ]
    },
    "ext.instantIIIF.veMediaInsert": {
      "scripts": [
        "resources/ve-media-insert.js"
      ],
      "targets": [
        "desktop",
        "mobile"
      ],
      "dependencies": [
        "ext.instantIIIF.title"
      ]
    },
    "ext.instantIIIF.filePage": {
      "styles": [
        "resources/file-page.css"
      ],
      "targets": [
        "desktop",
        "mobile"
      ]
    }
  },
  "ServiceWiringFiles": [
    "src/ServiceWiring.php"
  ],
  "HookHandlers": {
    "main": {
      "class": "MediaWiki\\Extension\\InstantIIIF\\Infrastructure\\MediaWiki\\HookHandler",
      "services": [
        "RepoGroup",
        "NamespaceInfo",
        "InstantIIIF.MetadataExtractor"
      ]
    }
  },
  "Hooks": {
    "BeforePageDisplay": "main",
    "ThumbnailBeforeProduceHTML": "main",
    "ImagePageFileHistoryLine": "main",
    "ImagePageShowTOC": "main",
    "GetExtendedMetadata": "main"
  },
  "SpecialPages": {
    "InstantIIIFInspect": {
      "class": "MediaWiki\\Extension\\InstantIIIF\\Infrastructure\\MediaWiki\\SpecialInstantIIIFInspect",
      "services": [
        "RepoGroup",
        "MainConfig",
        "InstantIIIF.MetadataExtractor"
      ]
    }
  },
  "AvailableRights": [
    "instantiiif-inspect"
  ],
  "GroupPermissions": {
    "sysop": {
      "instantiiif-inspect": true
    }
  }
}
